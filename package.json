{
  "name": "chzzk-stream-deck",
  "version": "3.0.1",
  "description": "CHZZK Stream Deck - 치지직 스트리밍을 위한 실시간 채팅 위젯 관리 시스템",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dev": "node --watch server.js",
    "build": "electron-builder --publish=never",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "build:win:portable": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable --x64 --publish never",
    "build:release": "node scripts/release-artifacts.js --check-version && npm run test:ci && npm run test:registration && npm run build:native && npm run build:win:portable -- --config.directories.output=dist/release && node scripts/release-artifacts.js",
    "test:ci": "node --test test/*.test.js test/*.test.mjs",
    "dist": "electron-builder --publish=never",
    "chat-test": "node src/chat-client.js",
    "api-test": "node test/chzzk-api-test.js",
    "channel-info": "node test/chzzk-channel-info.js",
    "test": "npm run test:ci",
    "test:outputs": "node --test test/output-modules.test.js",
    "build:ndi": "powershell -NoProfile -ExecutionPolicy Bypass -File native/a1-output/build.ps1",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File native/a1-output/Build-OBSPlugin.ps1 -AllowMissingOBS",
    "test:deck": "node --test test/deck-modules.test.mjs",
    "build:icons": "electron scripts/build-icons.cjs",
    "test:lifecycle": "node --test test/lifecycle.test.js",
    "test:setup": "node --test test/local-setup.test.js test/local-workflow.test.mjs",
    "test:motion": "node --test test/spring.test.mjs",
    "test:registration": "python test/obs-registration-test.py",
    "test:chat-overlay": "electron test/smoke-chat-overlay.cjs",
    "check": "node scripts/check.js",
    "build:mac": "electron-builder --mac --arm64 --publish=never"
  },
  "keywords": [
    "obs",
    "chzzk",
    "stream",
    "overlay"
  ],
  "author": "pileuszu",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.chzzk.streamdeck",
    "productName": "CHZZK Stream Deck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!test/**/*",
      "!*.md",
      "!*.git*",
      "!build/**/*",
      "!native/**/*",
      "!native-runtime/**/*",
      "!test-results/**/*",
      "!.data/**/*",
      "!.local-backups/**/*"
    ],
    "asar": false,
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "artifactName": "CHZZK-Stream-Deck-${version}-win-${arch}-portable.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "signExecutable": false,
      "signAndEditExecutable": false,
      "icon": "assets/icons/icon.ico",
      "extraResources": [
        {
          "from": "native-runtime",
          "to": "a1-output"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CHZZK Stream Deck"
    },
    "beforePack": "./scripts/stage-native.js",
    "afterPack": "./scripts/after-pack.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    }
  }
}
