{
  "name": "chzzk-stream-deck",
  "version": "2.1.0",
  "description": "치지직 채팅과 OBS 오버레이를 위한 로컬 방송 준비실",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "chat-test": "node src/chat-client.js",
    "build": "electron-builder --publish=never",
    "build:mac": "electron-builder --mac --arm64 --publish=never",
    "build:win": "electron-builder --win --publish=never",
    "build:win:portable": "electron-builder --win portable --publish=never",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [
    "obs",
    "chzzk",
    "stream",
    "overlay"
  ],
  "author": "pileuszu",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.chzzk.streamdeck",
    "productName": "CHZZK Stream Deck",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "config.json",
      "index.html",
      "src/**",
      "shared/**",
      "css/**",
      "js/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
